# ==============================================================================
# CareCircle AI — Express Backend Gateway (.env.example)
# ==============================================================================
# Copy this file to backend/.env:
#   cp .env.example .env
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# MongoDB Database Connection String
# Local MongoDB: mongodb://localhost:27017/carecircle_ai
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/carecircle_ai?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/carecircle_ai

# Security & Authentication
# Generate a production secret using: openssl rand -hex 32
JWT_SECRET=carecircle_jwt_secret_fake_dev_key_replace_in_production_2026

# Microservice & Client Integration
FASTAPI_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
