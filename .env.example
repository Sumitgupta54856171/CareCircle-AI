# ==============================================================================
# CareCircle AI — Master Environment Configuration Template (.env.example)
# ==============================================================================
# This file contains all environment variable names, secret templates, and fake
# placeholder credentials required to run CareCircle AI.
#
# To setup your local environment:
#   1. Express Backend:  cp backend/.env.example backend/.env
#   2. FastAPI AI:       cp fastapi/.env.example fastapi/.env
#   3. React Frontend:   cp frontend/.env.example frontend/.env
#
# Replace the placeholder values with your real credentials before deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. EXPRESS BACKEND GATEWAY (backend/.env)
# ------------------------------------------------------------------------------
# Port where the Express API gateway listens for incoming requests
PORT=5000

# Node execution environment: 'development' | 'production' | 'test'
NODE_ENV=development

# MongoDB Connection String
# - Local MongoDB instance: mongodb://localhost:27017/carecircle_ai
# - Cloud MongoDB Atlas:    mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/carecircle_ai?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/carecircle_ai

# JWT Secret Key for signing user authentication tokens
# In production, generate a secure random 64-character hexadecimal string:
# Run: openssl rand -hex 32
JWT_SECRET=carecircle_jwt_secret_fake_dev_key_replace_in_production_2026

# Internal URL to the Python FastAPI AI Microservice
FASTAPI_URL=http://localhost:8000

# Allowed client origin URL for CORS policy and security headers
FRONTEND_URL=http://localhost:5173


# ------------------------------------------------------------------------------
# 2. FASTAPI AI & MULTIMODAL MICROSERVICE (fastapi/.env)
# ------------------------------------------------------------------------------
# Network and server binding settings
PORT=8000
HOST=0.0.0.0
DEBUG=True
ENVIRONMENT=development

# Google Cloud Vertex AI / Gemini 2.5 Flash Configuration:
# - Option A (GCP Vertex AI Project ID):
#   Set your Google Cloud project with Vertex AI API enabled (e.g. 'my-health-app-123456')
GOOGLE_CLOUD_PROJECT=your-gcp-project-id-placeholder

# - GCP Region where Gemini models are hosted:
GOOGLE_CLOUD_LOCATION=us-central1

# - Option B (Google AI Studio API Key):
#   If authenticating via an AI Studio API key starting with 'AIzaSy...':
GEMINI_API_KEY=AIzaSyFakePlaceholderKeyForGeminiAPI_ReplaceWithRealKey2026


# ------------------------------------------------------------------------------
# 3. REACT FRONTEND CLIENT (frontend/.env)
# ------------------------------------------------------------------------------
# Base URL for the Express backend REST API
VITE_API_URL=http://localhost:5000

# Base URL for the FastAPI AI Microservice
VITE_FASTAPI_URL=http://localhost:8000
