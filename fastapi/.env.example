# ==============================================================================
# CareCircle AI — FastAPI AI Microservice (.env.example)
# ==============================================================================
# Copy this file to fastapi/.env:
#   cp .env.example .env
# ==============================================================================

# Server Network Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True
ENVIRONMENT=development

# Google Cloud Vertex AI & Gemini Foundation Models
# Set your GCP Project ID (with Vertex AI API enabled) or Gemini API Key:
GOOGLE_CLOUD_PROJECT=your-gcp-project-id-placeholder
GOOGLE_CLOUD_LOCATION=us-central1

# Gemini API Key (Alternative for Google AI Studio users: starts with 'AIzaSy...')
GEMINI_API_KEY=AIzaSyFakePlaceholderKeyForGeminiAPI_ReplaceWithRealKey2026
